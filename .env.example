# Сервис не требует секретов. Необязательные настройки для слабого хостинга
# (Render Free: 0.1 CPU / 512 MB RAM) — значения по умолчанию берутся из config/keywords.yaml.
# WHISPER_MODEL=tiny
# WHISPER_CPU_THREADS=1
# WHISPER_BEAM_SIZE=1
# MAX_UPLOAD_MB=25
# WHISPER_PROMPT=      # пусто — отключить подсказку словаря
# AUDIO_PREPROCESS=0     # отключить подготовку звука
